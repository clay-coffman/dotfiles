# Base Brewfile — shared between work and personal Macs.
# Per-machine additions live in ~/.Brewfile.work and ~/.Brewfile.personal,
# applied by run_onchange_brew-bundle.sh after this one.

# Taps
tap "FelixKratz/formulae"
tap "nikitabobko/tap"
tap "yoanwai/tap"

# Shell + terminal
brew "neovim"
brew "tmux"
brew "fzf"
brew "bat"
brew "ripgrep"
brew "fd"
brew "zoxide"
brew "starship"
brew "lazygit"
brew "yazi"
brew "atuin"
brew "direnv"
brew "entr"
brew "jq"
brew "git-delta"
brew "prettierd"
brew "sqlfluff"
brew "pgcli"

# System monitoring
brew "btop"
brew "htop"

# Version managers
# Pulls in `usage` as a dependency, which is what generates mise's shell
# completions at runtime.
brew "mise"

# Identity / dotfiles tooling
brew "chezmoi"
brew "gh"
brew "mas"
# Secret scanner — guards `dotfiles-publish` before anything reaches the public repo.
brew "gitleaks"

# Window manager + borders
brew "felixkratz/formulae/borders"

# Casks
# Note: docker-desktop intentionally not pinned here — `brew bundle` can't
# adopt a pre-existing /Applications/Docker.app without an interactive sudo
# for chmod, which breaks unattended `chezmoi apply`. On a fresh Mac with no
# Docker, install once with: brew install --cask docker-desktop
cask "ghostty"
cask "nikitabobko/tap/aerospace"
# agent-manager runs Claude/Codex agents on a private tmux server; the
# `agent-manager` wrapper function in private_dot_zshrc.tmpl depends on it.
# It was installed by hand and tracked nowhere, so a new Mac got the shell
# function but not the binary it calls.
cask "yoanwai/tap/agent-manager"
cask "1password-cli"
cask "font-iosevka-term-nerd-font"
cask "font-monaspice-nerd-font"
