# Font — Monaspace Xenon (slab serif), Nerd Font patched build ("MonaspiceXe")
# so tmux/statusline glyphs keep their size instead of Ghostty's scaled-down
# symbols fallback. Texture healing lives in calt (on by default); the coding
# ligatures ship in stylistic sets that must be opted into.
font-family = MonaspiceXe NF
font-style = Medium
font-style-bold = Bold
font-style-italic = Medium Italic
font-style-bold-italic = Bold Italic
font-size = 13
font-feature = ss01, ss02, ss03, ss04, ss05, ss06, ss07, ss08, ss09, liga

# Theme — auto-switch based on system appearance
theme = light:GitHub Light High Contrast,dark:GitHub Dark High Contrast

# Contrast floor — keep even partially styled TUI text readable. Some apps
# replace the terminal background without replacing its default foreground;
# 4.5:1 prevents a light-profile foreground from disappearing on a dark fill.
minimum-contrast = 4.5

# Cursor
cursor-style = block
cursor-style-blink = false

# Bell — disable audio, keep visual
bell-features = no-audio,no-system,attention,title

# Shell integration
shell-integration = detect

# Multi-process: each launch gets its own process so KWin places new
# windows in the current activity instead of routing through the existing
# instance.
gtk-single-instance = false

# Window
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true
macos-titlebar-style = hidden
gtk-titlebar = false

# Tabs
gtk-tabs-location = top
