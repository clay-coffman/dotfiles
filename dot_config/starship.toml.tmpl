# version: 1.0.0

add_newline         = false
continuation_prompt = "[▸▹ ](fg:color_surface2)"
command_timeout     = 5000
scan_timeout        = 100

{{- $palette := "github_light" -}}
{{- if eq .chezmoi.os "darwin" -}}
  {{- if eq (output "sh" "-c" "defaults read -g AppleInterfaceStyle 2>/dev/null || echo light" | trim | lower) "dark" -}}
    {{- $palette = "github_dark" -}}
  {{- end -}}
{{- else -}}
  {{- if eq (output "sh" "-c" (printf "cat %s/.cache/theme-mode 2>/dev/null || echo light" .chezmoi.homeDir) | trim) "dark" -}}
    {{- $palette = "github_dark" -}}
  {{- end -}}
{{- end }}
palette = '{{ $palette }}'

format = """($nix_shell$container$fill$git_metrics\n)$cmd_duration\
$hostname\
$localip\
$shlvl\
$shell\
$env_var\
$jobs\
$sudo\
${custom.nod}\
$username\
$character"""

