{{- /* Only emits the override when the carepilot signing key is populated.
    Without this guard, an empty `signingkey =` line would shadow the parent
    gitconfig's signingkey inside ~/Dev/carepilot/repos/ and break signing. */ -}}
{{- if .ssh_signing_keys.carepilot }}
# Loaded via `includeIf "gitdir:~/Dev/carepilot/repos/"` in ~/.gitconfig.
# Signs commits inside the work org's repositories with a separate key.
#
# Unlike the parent gitconfig, this file signs with a passphrase-less key file
# and calls ssh-keygen directly rather than going through 1Password's
# op-ssh-sign. The full reasoning sits next to ssh_signing_keys.carepilot in
# .chezmoidata.yaml. The short version is that the vault locks on idle,
# op-ssh-sign then fails, `git commit` aborts rather than signing, and the coding
# agents that drive these repositories answer that abort by committing with no
# signature at all. Those commits then block pull request merges.
#
# The path to ssh-keygen is absolute on purpose, because some of those agents run
# their commits inside sandboxes that carry a reduced PATH.
[user]
	signingkey = {{ .chezmoi.homeDir }}/{{ .carepilot_signing_key_file }}
[gpg "ssh"]
	program = /usr/bin/ssh-keygen
{{- else }}
# Placeholder. Populate ssh_signing_keys.carepilot in .chezmoidata.yaml with the
# public half of the signing key described there, then run `chezmoi apply`. The
# private half is generated by run_once_after_bootstrap-carepilot-signing-key.sh.
{{- end }}
