# Conductor writes its own host entries into ~/.ssh/conductor_config and marks
# that file "Auto-generated by Conductor. Do not edit." It is app-owned and
# untracked, so only the Include lives here. Keeping the line in the template
# stops `chezmoi apply` from deleting it and stops Conductor from re-adding a
# duplicate. A missing Include target is silently ignored by OpenSSH, so this is
# harmless on machines without Conductor.
Include {{ .chezmoi.homeDir }}/.ssh/conductor_config

# Conductor cloud sandboxes enforce a low SSH MaxAuthTries limit. Offer only
# the per-workspace key from Conductor's generated host entry instead of every
# key exposed by the 1Password agent.
Host *.conductor
	IdentitiesOnly yes
	IdentityAgent none

# Private dotfiles sync hub (cloud-hil-1). Uses a dedicated passphrase-less
# automation key, NOT the 1Password agent, so the unattended chezmoi-sync timer
# never trips an unlock prompt. Must stay ABOVE `Host *` — ssh uses the first
# value it sees for each keyword, so this IdentityAgent override has to win.
Host chezmoi-hub
	HostName {{ .sync_hub.ip }}
	User {{ .sync_hub.user }}
	IdentityFile ~/.ssh/chezmoi_sync_ed25519
	IdentitiesOnly yes
	IdentityAgent none
{{ if .work }}
{{ onepasswordRead "op://Employee/work ssh config/notesPlain" "carepilot.1password.com" }}
{{- end }}

Host *
	IdentityAgent ~/.1password/agent.sock

Host cloud-hil-1
	HostName 5.78.200.91
	User root
	# No ForwardAgent here: a compromised remote host can use a forwarded agent
	# socket to authenticate as you anywhere your keys work. Use `ssh -A` for
	# the rare session that genuinely needs it.
	ServerAliveInterval 60
	ServerAliveCountMax 3
{{ if has (output "hostname" "-s" | trim) .remoteHosts }}
Host github-personal-site
	HostName github.com
	User git
	IdentityFile /root/.ssh/personal_site_deploy
	IdentitiesOnly yes
{{ else }}
Host github.com
	HostName github.com
	User git
{{- end }}
