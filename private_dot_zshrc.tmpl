###################################################################################################
# ENV Vars + Path stuff
###################################################################################################

export LANG=en_US.UTF-8
export EDITOR=nvim

export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
{{ if eq .chezmoi.os "linux" -}}
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
{{ else -}}
# macOS has no systemd /run/user/$UID; force a private dir under the per-user TMPDIR.
# Set unconditionally (NOT ${VAR:-default}): a stale /run/user/$UID value is often
# inherited from a long-lived tmux server or parent process, and :- would not correct it.
_xdg_tmp="${TMPDIR:-/tmp}"; _xdg_tmp="${_xdg_tmp%/}"
export XDG_RUNTIME_DIR="$_xdg_tmp/xdg-runtime-$(id -u)"
[ -d "$XDG_RUNTIME_DIR" ] || mkdir -p -m 700 "$XDG_RUNTIME_DIR"
unset _xdg_tmp
{{ end -}}

export PRETTIERD_DEFAULT_CONFIG="$HOME/.prettierrc.yaml"
export TAPLO_CONFIG="$XDG_CONFIG_HOME/taplo.toml"
export RIPGREP_CONFIG_PATH="$XDG_CONFIG_HOME/ripgrep/config"

# Tool-specific install locations
export BUN_INSTALL="$HOME/.bun"
export FLYCTL_INSTALL="$HOME/.fly"
# Where `cargo install` puts the binaries it builds. mise exports this too, but
# only while a rust version is active, so it is also set here. Respect an
# inherited value rather than overwriting it.
export CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}"

# Keep PATH free of duplicates. zsh ties the $path array and the $PATH string
# together, so marking the array unique makes every later prepend a no-op when
# the directory is already present. Prepending a directory that already exists
# still moves it to the front and removes the stale copy, so priority ordering
# is unaffected. Without this line the export below adds another copy of the
# same directories every time one shell is nested inside another, which is the
# normal case here, since a login shell starts tmux, tmux starts an agent, and
# the agent starts subshells of its own.
typeset -U path PATH

# Single consolidated PATH (order = priority, first wins)
#
# mise deliberately does not appear here. Unlike asdf, which needed its shim
# directory prepended statically, mise rewrites PATH on every prompt from the
# `mise activate` hook further down in the Prompt tooling section.
#
# $CARGO_HOME/bin does appear here, even though mise already adds it, because
# mise only adds it as a side effect of the `rust` pin in
# ~/.config/mise/config.toml. Remove that pin, or shadow it with a repository
# local mise.toml that does not list rust, and every binary from `cargo install`
# quietly disappears from PATH. Listing it here makes it a guaranteed floor
# instead of a side effect. mise still prepends its own copy ahead of this one,
# so the active toolchain continues to win for cargo and rustc themselves. It
# sits behind the two hand-curated script directories so that a script of my own
# always beats a third-party binary of the same name.
export PATH="\
$BUN_INSTALL/bin:\
$FLYCTL_INSTALL/bin:\
$HOME/.local/bin:\
$HOME/bin:\
$CARGO_HOME/bin:\
$PATH"

###################################################################################################
# History + Shell Options
###################################################################################################

HISTFILE="${XDG_STATE_HOME}/zsh/history"
[[ ! -d "${HISTFILE:h}" ]] && mkdir -p "${HISTFILE:h}"
HISTSIZE=10000
SAVEHIST=10000

setopt HIST_IGNORE_ALL_DUPS
setopt APPEND_HISTORY
setopt SHARE_HISTORY
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_FIND_NO_DUPS
setopt HIST_REDUCE_BLANKS
setopt HIST_VERIFY
setopt INC_APPEND_HISTORY
setopt AUTO_CD
setopt EXTENDED_GLOB
setopt CORRECT
SPROMPT='zsh: correct %F{red}%R%f to %F{green}%r%f [nyae]? '

# Empty the command hash table before every prompt. zsh remembers where on PATH
# it found each command it has run, and a binary installed after that table was
# built stays invisible to the current shell until the table is cleared. With
# CORRECT switched on above, the symptom is that zsh offers to "correct" a
# command that really does exist: install a tool with `cargo install`, run it,
# and zsh asks whether you meant `ls`. Clearing the table is all `rehash` does,
# because entries are refilled lazily on the next lookup, so this is free rather
# than a rescan of every PATH directory on each prompt.
#
# The hook has to be a wrapper function rather than `rehash` itself. add-zsh-hook
# finishes by running `autoload -- <name>` on whatever name it is given, so
# passing it the name of a builtin replaces that builtin with an autoload stub
# that searches fpath for a file called `rehash`, finds nothing, and fails on
# every prompt with "rehash: function definition file not found". Calling it as
# `builtin rehash` inside the wrapper keeps it pointed at the builtin even if
# something else later defines a function of the same name.
_rehash_precmd() { builtin rehash }
autoload -Uz add-zsh-hook
add-zsh-hook precmd _rehash_precmd

WORDCHARS=${WORDCHARS//[\/]}

###################################################################################################
# Completions
###################################################################################################

zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$XDG_CACHE_HOME/zsh/zcompcache"

[[ ! -d "$XDG_CACHE_HOME/zsh" ]] && mkdir -p "$XDG_CACHE_HOME/zsh"

if [[ -d "$HOME/.zsh/completions" ]]; then
  fpath=("$HOME/.zsh/completions" $fpath)
fi

if [[ -d "$HOME/.docker/completions" ]]; then
  fpath=("$HOME/.docker/completions" $fpath)
fi

# mise needs no entry here. The Homebrew formula installs its completions into
# /opt/homebrew/share/zsh/site-functions, which `brew shellenv` in .zprofile
# already puts on fpath. Completion itself is generated at runtime by `usage`,
# a dependency Homebrew pulls in with mise.

if [[ -d "$HOME/.config/hcloud/completion/zsh" ]]; then
  fpath=("$HOME/.config/hcloud/completion/zsh" $fpath)
fi

###################################################################################################
# Zi plugin manager
###################################################################################################

typeset -A ZI
ZI[BIN_DIR]="$HOME/.zi/bin"

if [[ -f "${ZI[BIN_DIR]}/zi.zsh" ]]; then
  source "${ZI[BIN_DIR]}/zi.zsh"
else
  print "Zi not found at ${ZI[BIN_DIR]}/zi.zsh – install with: sh -c \"\$(curl -fsSL get.zshell.dev)\" --" >&2
fi

autoload -Uz _zi 2>/dev/null
(( ${+_comps} )) && _comps[zi]=_zi

###################################################################################################
# Plugins via Zi
###################################################################################################

ZVM_LINE_INIT_MODE=$ZVM_MODE_INSERT
ZVM_KEYTIMEOUT=0.40
ZVM_ESCAPE_KEYTIMEOUT=0.03
ZVM_SYSTEM_CLIPBOARD_ENABLED=true
ZVM_INIT_MODE=sourcing

zi ice depth=1
zi light jeffreytse/zsh-vi-mode

zi ice wait lucid has'zoxide'
zi light z-shell/zsh-zoxide

zi ice wait lucid
zi snippet OMZ::plugins/git/git.plugin.zsh

zi ice wait lucid
zi snippet OMZ::plugins/alias-finder/alias-finder.plugin.zsh

if (( $+functions[zicompinit] )); then
  zicompinit
  zicdreplay
else
  autoload -Uz compinit
  compinit -C
fi

###################################################################################################
# bat theme — GitHub light/dark, matching the terminal
###################################################################################################

{{ if has (output "hostname" "-s" | trim) .remoteHosts -}}
# Remotes are deliberately dark-only (see dot_tmux.conf.tmpl). The custom theme
# is built into bat's cache by run_onchange_after_bat-cache.sh.
export BAT_THEME=github-dark-custom
{{- else if eq .chezmoi.os "darwin" -}}
# bat resolves auto:system per invocation from the macOS appearance, so
# mid-session light/dark flips need no daemon and no new shell.
export BAT_THEME="auto:system"
export BAT_THEME_LIGHT=GitHub
export BAT_THEME_DARK=github-dark-custom
{{- else -}}
[[ -f ~/.cache/bat-theme.env ]] && source ~/.cache/bat-theme.env
{{- end }}

###################################################################################################
# FZF
###################################################################################################

if command -v fzf >/dev/null 2>&1; then
  # Source the picker from fd rather than `rg --files`. ripgrep reads
  # RIPGREP_CONFIG_PATH, so its global --glob excludes (node_modules, .venv,
  # __pycache__) silently hid those paths from the picker, and `rg --files`
  # lists only regular files, so directories and sockets never showed up either.
  export FZF_DEFAULT_COMMAND='fd --hidden --follow --exclude .git'

  # Preview that survives a directory, a socket, or an unreadable entry. tree is
  # pinned in the Brewfile but may be absent on the Fedora remotes, so fall back
  # to ls rather than rendering a silently blank pane.
  _fzf_preview='if [ -d {} ]; then (tree -C {} 2>/dev/null || ls -lAh {}); else (bat --color=always {} 2>/dev/null || ls -lAh {}); fi | head -200'

  export FZF_DEFAULT_OPTS="--height 40% --reverse --border --preview '$_fzf_preview' --preview-window=right:60%:wrap"
  export FZF_CTRL_T_OPTS="--preview '$_fzf_preview'"
  export FZF_ALT_C_OPTS="--preview '$_fzf_preview'"
  unset _fzf_preview

  # Light/dark base scheme, maintained by theme-sync(-mac). Read per
  # invocation, so appearance flips don't need a new shell.
  [[ -f ~/.cache/fzf-colors ]] && export FZF_DEFAULT_OPTS_FILE=~/.cache/fzf-colors

  # Load fzf keybindings + completion
  source <(fzf --zsh)

  # AeroSpace owns Option-C for the Claude workspace, so fzf's stock
  # Option-C directory widget never receives the key on macOS. Ctrl-] is
  # unbound in every zsh-vi-mode keymap and passes through Ghostty and tmux.
  # Keep the stock Option-C mapping too: Esc, then c is its non-conflicting
  # terminal-sequence equivalent when that is more convenient.
  bindkey -M emacs '^]' fzf-cd-widget
  bindkey -M viins '^]' fzf-cd-widget
  bindkey -M vicmd '^]' fzf-cd-widget
fi

###################################################################################################
# Custom Aliases & Functions
###################################################################################################

alias v="nvim"
alias c="clear"
alias l="ls -la"
alias cat="bat"
alias bake="mbake"
alias open='xdg-open'
alias update='sudo dnf update'
alias search='dnf search'
alias install='sudo dnf install'

# Codex, with the chezmoi-managed profile overlay layered on. Bare `codex` reads
# only the app-owned ~/.codex/config.toml, so use `cx` to get the tracked
# settings (dot_codex/main.config.toml.tmpl). `-p` is accepted by the top-level
# TUI and by subcommands like `exec`, so `cx exec ...` works too.
alias cx='codex -p main'

# Journaling
alias journal='jrnl'

# clipboard
if command -v wl-copy &> /dev/null; then
    alias pbcopy='wl-copy'
    alias pbpaste='wl-paste'
elif command -v xclip &> /dev/null; then
    alias pbcopy='xclip -selection clipboard'
    alias pbpaste='xclip -selection clipboard -o'
fi

# Linear personal API key, fetched from 1Password only when something actually
# asks for it. Deliberately a function rather than an export. An exported value
# would be inherited by every process this shell starts, and it would also sit
# in cleartext in ~/.zshrc, because chezmoi resolves onepasswordRead when you
# run `chezmoi apply` rather than when the shell starts. Fetching on demand
# keeps the value inside one short-lived command substitution, and it turns
# each use into an explicit Touch ID authorization. Pinned to the personal
# account because the subscription is personal, which is how the old export
# was pinned too. See CLAUDE.md "Secrets" for the general rule.
#
# Use it per command, which is also what the reconstruct-prd plugin's own
# documentation tells you to do:
#   LINEAR_API_KEY="$(linear-key)" scripts/integrate-project.sh "<Project Name>"
linear-key() {
    op read --no-newline --account my.1password.com \
        "op://Private/dxwwjmbvipibzfn7qjxntfu6jm/password"
}

# change CWD on quit from yazi (q) or (Q) to stay put
y() {
    local tmp cwd
    tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
    yazi "$@" --cwd-file="$tmp"
    IFS= read -r -d '' cwd < "$tmp"
    [[ -n "$cwd" && "$cwd" != "$PWD" ]] && builtin cd -- "$cwd"
    rm -f -- "$tmp"
}

# Broot's `br` is a shell function, not just an alias: when `:cd` or
# Option-Enter is used in Broot, it reads the selected directory from the
# out-command file and changes this parent shell's working directory. Keep the
# function managed here rather than accepting Broot's installer edit to
# ~/.zshrc. BR_INSTALL=no also suppresses that installer prompt.
br() {
    local tmp command broot_exit
    tmp="$(mktemp -t "broot-cwd.XXXXXX")"
    BR_INSTALL=no broot --outcmd "$tmp" "$@"
    broot_exit=$?
    IFS= read -r -d '' command < "$tmp"
    rm -f -- "$tmp"
    if [[ -n "$command" ]]; then
        eval "$command"
        return
    fi
    return "$broot_exit"
}

###################################################################################################
# Prompt tooling
###################################################################################################

# mise — dev-tool version manager, replacing asdf. Global pins live in
# ~/.config/mise/config.toml. `activate` installs a precmd hook that re-resolves
# PATH every time the prompt is drawn, so tools are found directly rather than
# through shim wrapper scripts. That is why the node bootstrap script no longer
# needs a reshim step after corepack adds pnpm and yarn.
#
# This is registered before starship so that mise has already adjusted PATH by
# the time the prompt asks a tool for its version.
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# Starship prompt
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

# Atuin (shell history)
if command -v atuin >/dev/null 2>&1; then
  eval "$(atuin init zsh)"
fi

# direnv — per-directory env loading. Requires `direnv allow` on each .envrc
# before it takes effect (prevents auto-exec of unreviewed files).
if command -v direnv >/dev/null 2>&1; then
  eval "$(direnv hook zsh)"
fi

# pnpm
export PNPM_HOME="$HOME/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end

# Google Cloud SDK
if [[ -d "$HOME/google-cloud-sdk" ]]; then
  [[ -f "$HOME/google-cloud-sdk/path.zsh.inc" ]] && source "$HOME/google-cloud-sdk/path.zsh.inc"
  [[ -f "$HOME/google-cloud-sdk/completion.zsh.inc" ]] && source "$HOME/google-cloud-sdk/completion.zsh.inc"
fi

# Windsurf CLI (windsurf, surf)
if [[ -d "$HOME/.codeium/windsurf/bin" ]]; then
  export PATH="$HOME/.codeium/windsurf/bin:$PATH"
fi

###################################################################################################
# Socket Firewall (supply-chain proxy from socket.dev)
###################################################################################################
# Routes package-manager traffic through sfw so malicious packages are blocked
# before install. Installed at /usr/local/bin/sfw by the Socket Firewall installer.
if command -v sfw >/dev/null 2>&1; then
  alias npm="sfw npm"
  alias yarn="sfw yarn"
  alias pnpm="sfw pnpm"
  alias pip="sfw pip"
  alias uv="sfw uv"
  alias cargo="sfw cargo"
fi

###################################################################################################
# Maestro (mobile UI testing)
###################################################################################################
# Nothing to wire up here any more. Maestro and the JDK it needs both come from
# mise ("github:mobile-dev-inc/maestro" and java = "temurin-17" in
# ~/.config/mise/config.toml), and `mise activate` exports JAVA_HOME pointing at
# the active install. Do not reinstall Maestro with its upstream script into
# ~/.maestro: that copy was tracked nowhere, would not reproduce on a new
# machine, and sat ahead of the pinned one on PATH.

###################################################################################################
# Tool completions / env (appended by installers; guarded so they're inert where absent)
###################################################################################################
# Bun completions
[[ -s "$HOME/.bun/_bun" ]] && source "$HOME/.bun/_bun"

# Railway CLI
# >>> railway initialize >>>
[[ -f "$HOME/.railway/env" ]] && source "$HOME/.railway/env"
# <<< railway initialize <<<
