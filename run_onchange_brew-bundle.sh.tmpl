{{- if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
# Re-runs whenever either Brewfile's content changes (hashes below).
# base-hash:     {{ include "dot_Brewfile" | sha256sum }}
# overlay-hash:  {{ include (printf "dot_Brewfile.%s" .role) | sha256sum }}
set -euo pipefail

if ! command -v brew >/dev/null 2>&1; then
	echo "Homebrew not installed — skipping brew bundle." >&2
	exit 0
fi

# Homebrew 6.0 refuses to load formulae and casks from untrusted third-party
# taps, and `brew bundle` exits non-zero when it hits one. Because this script
# runs under `set -e` and sorts before run_onchange_node-bootstrap, that failure
# aborts the whole `chezmoi apply` BEFORE any mise tool is installed. Trust is
# recorded in ~/.config/homebrew/trust.json, which is machine-local and tracked
# nowhere, so a fresh machine hit this wall on its first `chezmoi init --apply`
# and bootstrapped nothing.
#
# The tap list is derived from the Brewfiles rather than duplicated here.
# Declaring `tap "x/y"` (or a namespaced `brew`/`cask` entry) in a tracked,
# reviewed, signed Brewfile IS the trust decision; trust.json only records the
# same decision a second time. Nothing is trusted that the Brewfiles do not
# already ask Homebrew to install, so this adds no reach beyond `brew bundle`
# itself. `brew trust` is idempotent — an already-trusted tap prints a notice
# and exits 0.
trust_taps_from() {
	local file="$1"
	[[ -f "$file" ]] || return 0
	# Two forms: an explicit `tap "owner/name"`, and the owner/name prefix of a
	# namespaced entry such as `cask "owner/name/thing"`.
	{
		sed -nE 's/^tap "([^"/]+\/[^"/]+)".*/\1/p' "$file"
		sed -nE 's/^(brew|cask) "([^"/]+\/[^"/]+)\/[^"]+".*/\2/p' "$file"
	} | sort -u | while read -r tap; do
		[[ -n "$tap" ]] || continue
		brew trust "$tap" >/dev/null 2>&1 \
			|| echo "warning: could not trust tap $tap" >&2
	done
}

overlay="$HOME/.Brewfile.{{ .role }}"
trust_taps_from "$HOME/.Brewfile"
trust_taps_from "$overlay"

brew bundle --file "$HOME/.Brewfile"
[[ -f "$overlay" ]] && brew bundle --file "$overlay"
{{- end }}
