{{- if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
# Re-runs whenever either Brewfile's content changes (hashes below).
# base-hash:     {{ include "dot_Brewfile" | sha256sum }}
# overlay-hash:  {{ include (printf "dot_Brewfile.%s" .role) | sha256sum }}
set -euo pipefail

# Fail loudly rather than skipping. Homebrew is what installs mise, and
# run_onchange_node-bootstrap installs every mise tool — so a silent skip here
# used to cascade into a `chezmoi init --apply` that reported success while
# installing nothing at all. On macOS a missing Homebrew is a bootstrap error,
# not a condition to shrug at.
if ! command -v brew >/dev/null 2>&1; then
	cat >&2 <<-'MSG'
	ERROR: Homebrew is not installed, so no packages (including mise) can be
	installed and nothing downstream will bootstrap.

	Install it first, then re-run `chezmoi apply`:
	  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
	MSG
	exit 1
fi

# Homebrew 6.0 refuses to load formulae and casks from untrusted third-party
# taps, and `brew bundle` exits non-zero on the first one it hits. Because this
# script runs under `set -e` and sorts before run_onchange_node-bootstrap, that
# failure aborts the whole `chezmoi apply` BEFORE any mise tool is installed.
# Trust is recorded in ~/.config/homebrew/trust.json, which is machine-local and
# tracked nowhere, so a fresh machine hit this wall on its first
# `chezmoi init --apply` and bootstrapped nothing at all.
#
# Trust is granted PER ITEM, never per tap. Trusting a whole tap would also
# accept anything added to it later, including by a compromised maintainer —
# and tap compromise is not hypothetical; a malicious Trivy release shipped
# through exactly that route in March 2026. Naming each formula and cask means
# only the things this Brewfile already asks Homebrew to install are trusted,
# and adding one requires a reviewable Brewfile change.
#
# This is why third-party entries in the Brewfiles are written fully qualified
# as owner/tap/name. A bare `brew "foo"` cannot be attributed to a tap here, so
# it would silently go untrusted and break the bundle. Core formulae need no
# trust and are correctly skipped by these patterns.
trust_items_from() {
	local file="$1"
	[[ -f "$file" ]] || return 0
	sed -nE 's/^brew "([^"/]+\/[^"/]+\/[^"]+)".*/\1/p' "$file" | while read -r f; do
		brew trust --formula "$f" >/dev/null 2>&1 \
			|| echo "warning: could not trust formula $f" >&2
	done
	sed -nE 's/^cask "([^"/]+\/[^"/]+\/[^"]+)".*/\1/p' "$file" | while read -r c; do
		brew trust --cask "$c" >/dev/null 2>&1 \
			|| echo "warning: could not trust cask $c" >&2
	done
}

overlay="$HOME/.Brewfile.{{ .role }}"
trust_items_from "$HOME/.Brewfile"
trust_items_from "$overlay"

brew bundle --file "$HOME/.Brewfile"
[[ -f "$overlay" ]] && brew bundle --file "$overlay"
{{- end }}
